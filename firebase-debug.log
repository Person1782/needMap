[debug] [2026-10-14T18:07:20.562Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/needmap-hackathon/rulesets {"name":"projects/needmap-hackathon/rulesets/4fc3e89e-b478-4392-bc12-d79375c0bcc3","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function staffProfileExists() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid));\n    }\n\n    function isActiveStaff() {\n      return staffProfileExists()\n        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.active == true\n        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.role\n          in ['viewer', 'analyst', 'moderator', 'admin'];\n    }\n\n    function hasStaffRole(roles) {\n      return isActiveStaff()\n        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.role\n          in roles;\n    }\n\n    function isKnownCategory(category) {\n      return category in [\n        'healthcare',\n        'water',\n        'transportation',\n        'emergency_response',\n        'food',\n        'broadband',\n        'other'\n      ];\n    }\n\n    function hasValidCoordinates(data) {\n      return data.latitude is number\n        && data.latitude >= -90\n        && data.latitude <= 90\n        && data.longitude is number\n        && data.longitude >= -180\n        && data.longitude <= 180;\n    }\n\n    function isValidIncomingSignal() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'category',\n          'severity',\n          'summary',\n          'latitude',\n          'longitude',\n          'locationGridId',\n          'locationPrecision',\n          'sourceType',\n          'isSynthetic',\n          'submittedAt'\n        ])\n        && isKnownCategory(data.category)\n        && data.severity in ['low', 'medium', 'high']\n        && data.summary is string\n        && data.summary.size() >= 1\n        && data.summary.size() <= 280\n        && hasValidCoordinates(data)\n        && data.locationGridId is string\n        && data.locationGridId.size() >= 1\n        && data.locationGridId.size() <= 100\n        && data.locationPrecision in [\n          'approximate_grid_500m',\n          'manual_demo_coordinate'\n        ]\n        && data.sourceType == 'community_survey'\n        && data.isSynthetic is bool\n        && data.submittedAt is timestamp\n        && data.submittedAt == request.time;\n    }\n\n    function isValidRecommendationReview() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'candidateId',\n          'facilityType',\n          'regionId',\n          'regionName',\n          'category',\n          'latitude',\n          'longitude',\n          'status',\n          'owner',\n          'note',\n          'updatedBy',\n          'updatedAt'\n        ])\n        && data.candidateId is string\n        && data.candidateId.size() >= 1\n        && data.candidateId.size() <= 900\n        && data.facilityType is string\n        && data.facilityType.size() >= 1\n        && data.facilityType.size() <= 120\n        && data.regionId is string\n        && data.regionId.size() <= 300\n        && data.regionName is string\n        && data.regionName.size() <= 200\n        && isKnownCategory(data.category)\n        && hasValidCoordinates(data)\n        && data.status in ['new', 'reviewing', 'approved', 'rejected', 'pilot', 'built']\n        && data.owner is string\n        && data.owner.size() <= 80\n        && data.note is string\n        && data.note.size() <= 600\n        && data.updatedBy == request.auth.uid\n        && data.updatedAt is timestamp\n        && data.updatedAt == request.time;\n    }\n\n    function isValidModerationRecord() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'reportId',\n          'status',\n          'qualityScore',\n          'qualityIssues',\n          'possibleDuplicateOf',\n          'duplicateScore',\n          'updatedBy',\n          'updatedAt'\n        ])\n        && data.reportId is string\n        && data.reportId.size() >= 1\n        && data.reportId.size() <= 900\n        && data.status in ['approved', 'duplicate', 'hidden']\n        && data.qualityScore is number\n        && data.qualityScore >= 0\n        && data.qualityScore <= 100\n        && data.qualityIssues is list\n        && data.qualityIssues.size() <= 8\n        && data.possibleDuplicateOf is string\n        && data.possibleDuplicateOf.size() <= 900\n        && data.duplicateScore is number\n        && data.duplicateScore >= 0\n        && data.duplicateScore <= 1\n        && data.updatedBy == request.auth.uid\n        && data.updatedAt is timestamp\n        && data.updatedAt == request.time;\n    }\n\n    function isValidOutcomeFeedback() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'recommendationId',\n          'accessChange',\n          'rating',\n          'note',\n          'authorUid',\n          'createdAt'\n        ])\n        && data.recommendationId is string\n        && data.recommendationId.size() >= 1\n        && data.recommendationId.size() <= 900\n        && data.accessChange in ['better', 'same', 'worse']\n        && data.rating is int\n        && data.rating >= 1\n        && data.rating <= 5\n        && data.note is string\n        && data.note.size() >= 1\n        && data.note.size() <= 500\n        && data.authorUid == request.auth.uid\n        && data.createdAt is timestamp\n        && data.createdAt == request.time;\n    }\n\n    // Public reads power the standalone map. New reports still require a\n    // Firebase Anonymous Auth identity and must match the form's exact schema.\n    match /incomingSignals/{signalId} {\n      allow read: if true;\n      allow create: if isSignedIn() && isValidIncomingSignal();\n      allow update, delete: if false;\n    }\n\n    // Staff profiles are provisioned from the Firebase console or Admin SDK.\n    // Browser clients can only fetch their own profile and cannot grant roles.\n    match /staffProfiles/{userId} {\n      allow get: if isSignedIn() && request.auth.uid == userId;\n      allow list, create, update, delete: if false;\n    }\n\n    match /recommendationReviews/{reviewId} {\n      allow read: if isActiveStaff();\n      allow create: if hasStaffRole(['analyst', 'moderator', 'admin'])\n        && isValidRecommendationReview();\n      allow update: if hasStaffRole(['analyst', 'moderator', 'admin'])\n        && request.resource.data.candidateId == resource.data.candidateId\n        && isValidRecommendationReview();\n      allow delete: if hasStaffRole(['admin']);\n    }\n\n    match /reportModeration/{moderationId} {\n      allow read: if isActiveStaff();\n      allow create: if hasStaffRole(['moderator', 'admin'])\n        && isValidModerationRecord();\n      allow update: if hasStaffRole(['moderator', 'admin'])\n        && request.resource.data.reportId == resource.data.reportId\n        && isValidModerationRecord();\n      allow delete: if hasStaffRole(['admin']);\n    }\n\n    match /outcomeFeedback/{feedbackId} {\n      allow read: if isActiveStaff();\n      allow create: if hasStaffRole(['analyst', 'moderator', 'admin'])\n        && isValidOutcomeFeedback();\n      allow update: if false;\n      allow delete: if hasStaffRole(['admin']);\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-14T18:07:20.539391Z","metadata":{"services":["cloud.firestore"]}}
